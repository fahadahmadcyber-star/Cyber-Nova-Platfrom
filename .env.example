# ═══════════════════════════════════════════════════════════════
#  CYBER NOVA — Firebase Environment Variables
#  Copy this file to `.env` locally, or set these in:
#  Vercel → Project → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════
#  NOTE: Values are inlined at BUILD time by Vite.
#  After changing them in Vercel you MUST redeploy.
# ═══════════════════════════════════════════════════════════════

VITE_FIREBASE_API_KEY=your_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id

# Server-only AI key. Never prefix this with VITE_ or expose it in the browser.
# Add it to Vercel Project Settings -> Environment Variables.
GEMINI_API_KEY=your_gemini_api_key_here
