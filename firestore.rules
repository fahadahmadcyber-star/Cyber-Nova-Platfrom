rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() &&
        request.auth.token.email == 'fahadahmad.cyber@gmail.com';
    }

    function isAdmin() {
      return isOwner() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    match /admin/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /platform/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /settings/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /curriculum/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /support_messages/{messageId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /community_rooms/{roomId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /community_rooms/{roomId}/messages/{messageId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /progress/{progressId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId &&
        (request.resource.data.role == 'user' || isAdmin());
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() &&
        (isAdmin() ||
          (request.auth.uid == userId &&
            request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
